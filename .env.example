# Parcel Delivery System — environment defaults
# Copy to .env if you need local overrides (do not commit secrets).

# Auth-service MySQL only
MYSQL_ROOT_PASSWORD=root
MYSQL_USER=courier
MYSQL_PASSWORD=courier

# Domain services use dedicated MongoDB containers (URIs set in docker-compose):
#   parcel   → mongodb://mongo-parcel:27017/parceldb   (host: localhost:27016)
#   courier  → mongodb://mongo-courier:27017/courierdb (host: localhost:27018)
#   delivery → mongodb://mongo-delivery:27017/deliverydb (host: localhost:27019)

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

PARCEL_API_KEY=parcel-service-key
COURIER_API_KEY=courier-service-key
DELIVERY_API_KEY=delivery-service-key
AUTH_API_KEY=auth-service-key

JWT_SECRET=change-me-parcel-delivery-jwt-secret-key-32b
JWT_ISSUER=parcel-delivery-auth

AUTH_SEED_USERNAME=admin
AUTH_SEED_PASSWORD=password
# Track-only demo user (role USER)
AUTH_CUSTOMER_USERNAME=customer
AUTH_CUSTOMER_PASSWORD=password

RATE_LIMIT_REPLENISH=20
RATE_LIMIT_BURST=40
