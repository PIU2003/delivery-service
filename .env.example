# Parcel Delivery System — environment defaults
# Copy to .env if you need local overrides (do not commit secrets).

MYSQL_ROOT_PASSWORD=root
MYSQL_USER=courier
MYSQL_PASSWORD=courier

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

PARCEL_API_KEY=parcel-service-key
COURIER_API_KEY=courier-service-key
DELIVERY_API_KEY=delivery-service-key
AUTH_API_KEY=auth-service-key

JWT_SECRET=change-me-parcel-delivery-jwt-secret-key-32chars
